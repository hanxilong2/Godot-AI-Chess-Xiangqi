; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Chess Cafe"
config/tags=PackedStringArray("chess", "board_game", "cafe")
run/main_scene="res://scene/ui/start_menu.tscn"
config/features=PackedStringArray("4.5", "C#", "GL Compatibility")
run/max_fps=60
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/show_image=false
boot_splash/use_filter=false
config/icon="uid://gdemlmk1r3x4"
boot_splash/stretch_mode=0

[autoload]

Archive="*res://scene/ui/archive.tscn"
Dialog="*res://scene/ui/dialog.tscn"
Loading="*res://scene/ui/loading.tscn"
Progress="*res://src/common/progress.gd"
Ambient="*res://scene/common/ambient.tscn"
Clock="*res://src/common/clock.gd"
Setting="*res://scene/ui/setting.tscn"
CameraView="*res://scene/ui/camera_view.tscn"
ChessAI="*res://chess_ai_module/AI_Module_Entry.cs"

[debug]

gdscript/warnings/integer_division=0
gdscript/warnings/narrowing_conversion=0

[display]

window/stretch/mode="viewport"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="ChessCafe"

[editor]

naming/node_name_num_separator=2
naming/node_name_casing=2
naming/default_signal_callback_name="on_{node_name}_{signal_name}"
naming/default_signal_callback_to_self_name="on_{signal_name}"
naming/script_name_casing=2

[filesystem]

import/blender/enabled=false

